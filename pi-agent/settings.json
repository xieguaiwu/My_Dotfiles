{
  "defaultProvider": "bai",
  "defaultModel": "glm-5.3-flash",
  "defaultThinkingLevel": "xhigh",
  "hideThinkingBlock": false,
  "theme": "opencode",
  "collapseChangelog": true,
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "0.84.4",
  "packages": [
    "git:https://github.com/awtotty/pi-opencode.git",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-intercom",
    "git:https://github.com/MasuRii/pi-session-cleanup.git",
    "npm:pi-markdown-preview",
    "npm:pi-ask-user",
    "npm:pi-bar",
    "npm:@jerryan/pi-todo-lite",
    "npm:pi-memory",
    "npm:graphify-pi",
    "npm:pi-prompt-template-model"
  ],
  "bar": {
    "progressModel": "default"
  },
  "subagents": {
    "agentOverrides": {
      "scout": {
        "disabled": true
      },
      "worker": {
        "disabled": true
      },
      "reviewer": {
        "disabled": true
      },
      "planner": {
        "disabled": true
      },
      "explore": {
        "turnBudget": {
          "maxTurns": 15,
          "graceTurns": 3
        }
      },
      "deep": {
        "turnBudget": {
          "maxTurns": 25,
          "graceTurns": 5
        }
      },
      "hephaestus": {
        "turnBudget": {
          "maxTurns": 30,
          "graceTurns": 5
        }
      },
      "prometheus": {
        "turnBudget": {
          "maxTurns": 20,
          "graceTurns": 3
        }
      },
      "metis": {
        "turnBudget": {
          "maxTurns": 15,
          "graceTurns": 3
        }
      },
      "ultrabrain": {
        "turnBudget": {
          "maxTurns": 20,
          "graceTurns": 3
        }
      },
      "momus": {
        "turnBudget": {
          "maxTurns": 15,
          "graceTurns": 3
        }
      },
      "sisyphus": {
        "turnBudget": {
          "maxTurns": 20,
          "graceTurns": 3
        }
      },
      "sisyphus-junior": {
        "turnBudget": {
          "maxTurns": 25,
          "graceTurns": 5
        }
      },
      "researcher": {
        "model": "bai/glm-5.3-flash",
        "fallbackModels": [
          "bai/deepseek-v4-flash",
          "deepseek/deepseek-v4-flash",
          "opencode-go/deepseek-v4-flash"
        ]
      },
      "delegate": {
        "model": "bai/glm-5.3-flash",
        "fallbackModels": [
          "bai/deepseek-v4-flash",
          "deepseek/deepseek-v4-flash",
          "opencode-go/deepseek-v4-flash"
        ]
      },
      "oracle": {
        "model": "bai/glm-5.3-flash",
        "fallbackModels": [
          "bai/deepseek-v4-flash",
          "deepseek/deepseek-v4-flash",
          "opencode-go/deepseek-v4-flash"
        ]
      }
    }
  },
  "compaction": {
    "enabled": true
  },
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 60000
    }
  },
  "httpIdleTimeoutMs": 600000
}