#!/bin/sh
# pi-resmon v1.1.0 — Lightweight resource monitor for pi-agent orchestration
#
# Reads /proc and optional nvidia-smi, computes a risk score,
# and recommends subagent delegation strategy.
#
# Usage:
#   pi-resmon                           human-readable summary
#   pi-resmon --recommend               structured K=V for orchestrator
#   pi-resmon --recommend --class heavy class-aware recommendation
#   pi-resmon --show-thresholds         print decision thresholds
#   pi-resmon -v                        version
#
# Exit code: 0=ok, 1=error

set -eu

# ==============================================
# bc availability guard (use awk fallback if missing)
# Without this, tier classification silently falls
# to else branch → everything becomes CRITICAL.
# ==============================================
if command -v bc >/dev/null 2>&1; then
    _float_cmp() { echo "$1" | bc -l 2>/dev/null; }
else
    _float_cmp() {
        _expr="$1"
        # Expressions with 'scale=N;' prefix (arithmetic, not comparison)
        # awk cannot parse 'scale=3; 2.5/4' as a single expression because
        # ';' is a statement separator.  Split and use printf with precision.
        case "$_expr" in
            scale=*\;*)
                _scale="${_expr%%;*}"; _scale="${_scale#scale=}"
                _rhs="${_expr#*; }"
                awk -v _s="$_scale" 'BEGIN { printf "%." _s "f", ('"$_rhs"'); }' 2>/dev/null
                ;;
            *)
                awk "BEGIN { print ($_expr) ? 1 : 0 }" 2>/dev/null
                ;;
        esac
    }
fi

# Detect logical cores (default 4 if detection fails)
NPROC=$(nproc 2>/dev/null || grep -c ^processor /proc/cpuinfo 2>/dev/null || echo 4)

# ==============================================
# Argument parsing
# ==============================================
ACTION="summary"
AGENT_CLASS="medium"
while [ $# -gt 0 ]; do
    case "$1" in
        --recommend) ACTION="recommend" ;;
        --class)
            shift
            case "$1" in
                light|medium|heavy) AGENT_CLASS="$1" ;;
                *) echo "pi-resmon: unknown agent class '$1' (use light|medium|heavy)" >&2; exit 1 ;;
            esac
            ;;
        --show-thresholds) ACTION="thresholds" ;;
        -v|--version) echo "pi-resmon v1.1.0"; exit 0 ;;
        -h|--help)
            sed -n '/^# Usage:/,/^$/p' "$0" | sed 's/^# *//; /^$/d'
            exit 0 ;;
        *) echo "pi-resmon: unknown option '$1' (try -h)" >&2; exit 1 ;;
    esac
    shift
done

# ==============================================
# DATA COLLECTION
# ==============================================

# --- CPU Load (1m, 5m, 15m from /proc/loadavg) ---
read LOAD1 LOAD5 LOAD15 _REST1 _REST2 < /proc/loadavg 2>/dev/null || { LOAD1=0; LOAD5=0; LOAD15=0; }
LOAD1=${LOAD1:-0}; LOAD5=${LOAD5:-0}; LOAD15=${LOAD15:-0}

# Load ratio: 5-min average normalized by logical cores
LOAD_RATIO=$(_float_cmp "scale=3; $LOAD5 / $NPROC" || echo "0")
# Ensure leading zero for display consistency
case "$LOAD_RATIO" in .*) LOAD_RATIO="0$LOAD_RATIO" ;; -.*) LOAD_RATIO="0${LOAD_RATIO#-}" ;; esac

# Spike detection: 1-min load significantly exceeds 5-min trend
SPIKE=0
if [ "$(_float_cmp "$LOAD1 > 2 * $LOAD5")" = "1" ] || \
   [ "$(_float_cmp "$LOAD1 > $LOAD15 * 2")" = "1" ]; then
    SPIKE=1
fi

# --- PSI (Pressure Stall Information, kernel ≥4.20) ---
PSI_CPU=$(awk '/some avg10/ {gsub(/avg10=/,"",$2); print $2}' /proc/pressure/cpu 2>/dev/null || echo "0.00")
PSI_MEM=$(awk '/some avg10/ {gsub(/avg10=/,"",$2); print $2}' /proc/pressure/memory 2>/dev/null || echo "0.00")
PSI_IO=$(awk '/some avg10/ {gsub(/avg10=/,"",$2); print $2}' /proc/pressure/io 2>/dev/null || echo "0.00")

# --- Memory from /proc/meminfo ---
MEM_TOTAL=$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
MEM_AVAIL=$(awk '/MemAvailable/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
# Fallback for pre-3.14 kernels without MemAvailable
if [ -z "$MEM_AVAIL" ] || [ "$MEM_AVAIL" = "0" ]; then
  MEM_FREE=$(awk '/MemFree/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
  MEM_BUFFERS=$(awk '/Buffers/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
  MEM_CACHED=$(awk '/^Cached/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
  MEM_AVAIL=$((MEM_FREE + MEM_BUFFERS + MEM_CACHED))
fi
MEM_TOTAL_MB=$((MEM_TOTAL / 1024))
MEM_AVAIL_MB=$((MEM_AVAIL / 1024))

# --- cgroup memory limits (container / dotfiles awareness) ---
# v2 first (unified hierarchy), v1 fallback (legacy containers)
MEM_CGROUP_LIMIT="inf"
CGROUP_MAX="max"
CGROUP_CUR=0
if [ -f /sys/fs/cgroup/memory.max ]; then
    # cgroup v2
    read -r CGROUP_MAX < /sys/fs/cgroup/memory.max 2>/dev/null || CGROUP_MAX="max"
    if [ "$CGROUP_MAX" != "max" ] && [ -n "$CGROUP_MAX" ] && [ "$CGROUP_MAX" -gt 0 ] 2>/dev/null; then
        read -r CGROUP_CUR < /sys/fs/cgroup/memory.current 2>/dev/null || CGROUP_CUR=0
    fi
elif [ -f /sys/fs/cgroup/memory/memory.limit_in_bytes ]; then
    # cgroup v1 fallback (Docker legacy, older k8s)
    read -r CGROUP_MAX < /sys/fs/cgroup/memory/memory.limit_in_bytes 2>/dev/null || CGROUP_MAX="max"
    # v1 limit_in_bytes can be 9223372036854771712 (~max int64) → treat as unlimited
    if [ "$CGROUP_MAX" != "max" ] && [ -n "$CGROUP_MAX" ] && [ "$CGROUP_MAX" -lt 9223372036854771712 ] 2>/dev/null; then
        read -r CGROUP_CUR < /sys/fs/cgroup/memory/memory.usage_in_bytes 2>/dev/null || CGROUP_CUR=0
    fi
fi
if [ "$CGROUP_MAX" != "max" ] && [ -n "$CGROUP_MAX" ] && [ "$CGROUP_MAX" -gt 0 ] 2>/dev/null && [ "$CGROUP_CUR" -gt 0 ] 2>/dev/null; then
    CGROUP_AVAIL=$((CGROUP_MAX - CGROUP_CUR))
    CGROUP_AVAIL_MB=$((CGROUP_AVAIL / 1048576))
    if [ "$CGROUP_AVAIL_MB" -lt "$MEM_AVAIL_MB" ]; then
        MEM_AVAIL_MB=$CGROUP_AVAIL_MB
        MEM_CGROUP_LIMIT="set"
    fi
fi

# --- Swap ---
SWAP_TOTAL=$(awk '/SwapTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
SWAP_FREE=$(awk '/SwapFree/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)

SWAP_TYPE="none"
SWAP_PCT="0"
if [ "$SWAP_TOTAL" -gt 0 ] 2>/dev/null; then
    if grep -q '/dev/zram' /proc/swaps 2>/dev/null; then
        SWAP_TYPE="zram"
    else
        SWAP_TYPE="disk"
    fi
    SWAP_USED=$((SWAP_TOTAL - SWAP_FREE))
    # Guard against SwapFree > SwapTotal (edge case after reboot / cgroup migration)
    if [ "$SWAP_USED" -lt 0 ]; then
        SWAP_USED=0
    elif [ "$SWAP_USED" -gt "$SWAP_TOTAL" ]; then
        SWAP_USED="$SWAP_TOTAL"
    fi
    SWAP_PCT=$(_float_cmp "scale=1; $SWAP_USED * 100 / $SWAP_TOTAL" || echo "0")
    case "$SWAP_PCT" in .*) SWAP_PCT="0$SWAP_PCT" ;; esac
fi

# --- Disk usage (working directory partition) ---
# GNU df preferred; POSIX fallback via df -P + awk
if df --output=pcent . >/dev/null 2>&1; then
    DISK_PCT=$(df . --output=pcent 2>/dev/null | tail -1 | tr -d ' %')
else
    DISK_PCT=$(df -P . 2>/dev/null | awk 'NR==2 {print $5}' | tr -d '%')
fi
DISK_PCT=${DISK_PCT:-0}

# --- GPU (optional, via nvidia-smi) — sample all cards, take worst free memory
GPU_AVAIL="no"
GPU_MEM_FREE_PCT="0"
GPU_UTIL="0"
if command -v nvidia-smi >/dev/null 2>&1; then
    GPU_LINES=$(nvidia-smi --query-gpu=memory.total,memory.used,utilization.gpu --format=csv,noheader,nounits 2>/dev/null)
    if [ -n "$GPU_LINES" ]; then
        GPU_AVAIL="yes"
        _worst_free_pct="100"
        _worst_util="0"
        while IFS=', ' read -r _gpu_mem_total _gpu_mem_used _gpu_util; do
            [ -z "$_gpu_mem_total" ] && continue
            if [ "$_gpu_mem_total" -gt 0 ] 2>/dev/null; then
                _free_pct=$(_float_cmp "scale=1; ($_gpu_mem_total - $_gpu_mem_used) * 100 / $_gpu_mem_total" || echo "0")
                [ "$(_float_cmp "$_free_pct < $_worst_free_pct")" = "1" ] && _worst_free_pct="$_free_pct"
                [ "$(_float_cmp "$_gpu_util > $_worst_util")" = "1" ] && _worst_util="$_gpu_util"
            fi
        done <<GPUEOF
$GPU_LINES
GPUEOF
        GPU_MEM_FREE_PCT="$_worst_free_pct"
        GPU_UTIL="$_worst_util"
    fi
fi

# --- Self RSS (pi-agent session + spawned child processes) ---
SELF_RSS_MB=0
for _pid in $(pgrep '^(pi|node|python|python3)' 2>/dev/null); do
    _rss_val=$(ps -o rss= -p "$_pid" 2>/dev/null || echo 0)
    SELF_RSS_MB=$((SELF_RSS_MB + _rss_val / 1024))
done

# ==============================================
# TIER CLASSIFICATION
# Each tier: 0=LOW  1=MODERATE  2=HIGH  3=CRITICAL
# ==============================================

# --- Load tier (5-min avg / nproc) ---
if [ "$(_float_cmp "$LOAD_RATIO < 0.7")" = "1" ]; then load_tier=0
elif [ "$(_float_cmp "$LOAD_RATIO < 1.5")" = "1" ]; then load_tier=1
elif [ "$(_float_cmp "$LOAD_RATIO < 2.5")" = "1" ]; then load_tier=2
else load_tier=3; fi

# --- Memory tier (MemAvailable MB) ---
if   [ "$MEM_AVAIL_MB" -ge 4096 ]; then mem_tier=0
elif [ "$MEM_AVAIL_MB" -ge 2048 ]; then mem_tier=1
elif [ "$MEM_AVAIL_MB" -ge 1024 ]; then mem_tier=2
else mem_tier=3; fi

# --- PSI CPU tier ---
if   [ "$(_float_cmp "$PSI_CPU < 5")" = "1" ]; then psi_cpu_tier=0
elif [ "$(_float_cmp "$PSI_CPU < 20")" = "1" ]; then psi_cpu_tier=1
elif [ "$(_float_cmp "$PSI_CPU < 40")" = "1" ]; then psi_cpu_tier=2
else psi_cpu_tier=3; fi

# --- PSI Memory tier ---
if   [ "$(_float_cmp "$PSI_MEM < 1")" = "1" ]; then psi_mem_tier=0
elif [ "$(_float_cmp "$PSI_MEM < 5")" = "1" ]; then psi_mem_tier=1
elif [ "$(_float_cmp "$PSI_MEM < 15")" = "1" ]; then psi_mem_tier=2
else psi_mem_tier=3; fi

# --- Swap tier (type-dependent) ---
swap_tier=0
case "$SWAP_TYPE" in
    zram)
        # zram is compressed memory, not disk thrashing — much more lenient
        if   [ "$(_float_cmp "$SWAP_PCT < 70")" = "1" ]; then swap_tier=0
        elif [ "$(_float_cmp "$SWAP_PCT < 90")" = "1" ]; then swap_tier=1
        else swap_tier=2; fi  # zram never reaches tier 3
        ;;
    disk)
        # Real disk swap — system is likely overcommitted
        if   [ "$(_float_cmp "$SWAP_PCT < 5")" = "1" ]; then swap_tier=0
        elif [ "$(_float_cmp "$SWAP_PCT < 20")" = "1" ]; then swap_tier=1
        elif [ "$(_float_cmp "$SWAP_PCT < 50")" = "1" ]; then swap_tier=2
        else swap_tier=3; fi
        ;;
esac

# --- GPU tier (only if nvidia-smi available) ---
gpu_tier=0
if [ "$GPU_AVAIL" = "yes" ]; then
    if   [ "$(_float_cmp "$GPU_MEM_FREE_PCT >= 50")" = "1" ]; then gpu_tier=0
    elif [ "$(_float_cmp "$GPU_MEM_FREE_PCT >= 30")" = "1" ]; then gpu_tier=1
    elif [ "$(_float_cmp "$GPU_MEM_FREE_PCT >= 10")" = "1" ]; then gpu_tier=2
    else gpu_tier=3; fi
fi

# ==============================================
# RISK AGGREGATION
# ==============================================

# --- Disk tier (working directory partition usage) ---
disk_tier=0
if [ "$DISK_PCT" -gt 90 ] 2>/dev/null; then disk_tier=2  # MODERATE
elif [ "$DISK_PCT" -gt 80 ] 2>/dev/null; then disk_tier=1  # LOW→MODERATE bridge
fi

# Base risk = max of all primary indicators (now includes disk)
risk_num=$load_tier
[ "$mem_tier" -gt "$risk_num" ] && risk_num=$mem_tier
[ "$psi_mem_tier" -gt "$risk_num" ] && risk_num=$psi_mem_tier
[ "$psi_cpu_tier" -gt "$risk_num" ] && risk_num=$psi_cpu_tier
[ "$swap_tier" -gt "$risk_num" ] && risk_num=$swap_tier
[ "$gpu_tier" -gt "$risk_num" ] && risk_num=$gpu_tier
[ "$disk_tier" -gt "$risk_num" ] && risk_num=$disk_tier

# Agent class modifier: heavy agents tighten restrictions
if [ "$AGENT_CLASS" = "heavy" ] && [ "$risk_num" -ge 1 ]; then
    risk_num=$((risk_num + 1))
    [ "$risk_num" -gt 3 ] && risk_num=3
fi

# ==============================================
# RISK → STRATEGY MAPPING
# ==============================================
case $risk_num in
    0)
        RISK_LABEL="LOW"
        ACTION_STR="free_parallel"
        MAX_PARALLEL=4
        MAXTURNS_FACTOR="1.0"
        TIMEOUT_FACTOR="1.0"
        WEIGHT_AGENTS="all"
        ;;
    1)
        RISK_LABEL="MODERATE"
        ACTION_STR="restricted_parallel"
        MAX_PARALLEL=2
        MAXTURNS_FACTOR="0.8"
        TIMEOUT_FACTOR="1.2"
        WEIGHT_AGENTS="light+medium"
        ;;
    2)
        RISK_LABEL="HIGH"
        ACTION_STR="serialize_only"
        MAX_PARALLEL=1
        MAXTURNS_FACTOR="0.6"
        TIMEOUT_FACTOR="1.5"
        WEIGHT_AGENTS="light_only"
        ;;
    3)
        RISK_LABEL="CRITICAL"
        ACTION_STR="defer_or_direct"
        MAX_PARALLEL=1
        MAXTURNS_FACTOR="0.4"
        TIMEOUT_FACTOR="2.0"
        WEIGHT_AGENTS="none"
        ;;
esac

# ==============================================
# WARNINGS
# ==============================================
WARNINGS=""
if [ "$DISK_PCT" -gt 90 ] 2>/dev/null; then
    WARNINGS="${WARNINGS} disk_usage=${DISK_PCT}%"
fi
if [ "$SPIKE" = "1" ]; then
    WARNINGS="${WARNINGS} load_spike_1m=${LOAD1}"
fi
# Trim leading space
WARNINGS="${WARNINGS# }"

# ==============================================
# OUTPUT
# ==============================================

_print_recommend() {
    printf "RISK=%s LOAD_RATIO=%s MEM_AVAIL_MB=%d MEM_TOTAL_MB=%d MEM_CGROUP_LIMIT=%s SWAP_PCT=%s SWAP_TYPE=%s PSI_CPU=%s PSI_MEM=%s PSI_IO=%s GPU_AVAIL=%s DISK_PCT=%d SELF_RSS_MB=%d\n" \
        "$RISK_LABEL" "$LOAD_RATIO" "$MEM_AVAIL_MB" "$MEM_TOTAL_MB" "$MEM_CGROUP_LIMIT" "$SWAP_PCT" "$SWAP_TYPE" "$PSI_CPU" "$PSI_MEM" "$PSI_IO" "$GPU_AVAIL" "$DISK_PCT" "$SELF_RSS_MB"
    printf "ACTION=%s MAX_PARALLEL=%d SUGGESTED_MAXTURNS_FACTOR=%s SUGGESTED_TIMEOUTMS_FACTOR=%s WEIGHT_AGENTS=%s\n" \
        "$ACTION_STR" "$MAX_PARALLEL" "$MAXTURNS_FACTOR" "$TIMEOUT_FACTOR" "$WEIGHT_AGENTS"
    if [ -n "$WARNINGS" ]; then
        printf "WARNINGS=%s\n" "$WARNINGS"
    fi
}

_print_summary() {
    printf "pi-resmon: CPU:%.2f(5m)/%dc | Mem:%dMB avail/%dMB total | Swap:%s%%(%s) | PSI cpu:%s%% mem:%s%% io:%s%% | GPU:%s | Disk:%d%% | Self:%dMB | Risk:%s\n" \
        "$LOAD_RATIO" "$NPROC" "$MEM_AVAIL_MB" "$MEM_TOTAL_MB" "$SWAP_PCT" "$SWAP_TYPE" "$PSI_CPU" "$PSI_MEM" "$PSI_IO" "$GPU_AVAIL" "$DISK_PCT" "$SELF_RSS_MB" "$RISK_LABEL"
    if [ -n "$WARNINGS" ]; then
        printf "  Warnings:%s\n" "$WARNINGS"
    fi
}

_print_thresholds() {
    cat <<'THRESHOLDS'
=== pi-resmon v1.1.0 — Decision Thresholds ===

Load Ratio (5-min load / nproc logical cores):
  LOW      < 0.7
  MODERATE 0.7 – 1.5
  HIGH     1.5 – 2.5
  CRITICAL > 2.5

Memory (MemAvailable, cgroup-aware):
  LOW      >= 4 GB
  MODERATE 2 GB – 4 GB
  HIGH     1 GB – 2 GB
  CRITICAL < 1 GB

PSI CPU (some avg10 %):
  LOW      < 5%
  MODERATE 5% – 20%
  HIGH     20% – 40%
  CRITICAL > 40%

PSI Memory (some avg10 %):
  LOW      < 1%
  MODERATE 1% – 5%
  HIGH     5% – 15%
  CRITICAL > 15%

Swap (type-dependent):
  zram: LOW <70% | MODERATE 70-90% | HIGH >90%  (compressed RAM, not thrashing)
  disk: LOW <5% | MODERATE 5-20% | HIGH 20-50% | CRITICAL >50%

Disk (working directory partition usage %):
  LOW      < 80%
  MODERATE 80% – 90%
  HIGH     > 90%

GPU (if nvidia-smi available, by free memory %):
  LOW      free >= 50%
  MODERATE free 30-50%
  HIGH     free 10-30%
  CRITICAL free < 10%

Agent Class Modifier:
  heavy => risk +1 (max 3) when base risk >= MODERATE
  light / medium => no adjustment

Aggregation:
  risk = max(load, mem, psi_mem, psi_cpu, swap, gpu, disk)

Strategy:
  LOW       → free_parallel       max 4, all agent classes
  MODERATE  → restricted_parallel max 2, light+medium only
  HIGH      → serialize_only      max 1, light agents only
  CRITICAL  → defer_or_direct     max 1, handle directly, no subagents

Adjustments (apply to turnBudget.maxTurns & timeoutMs):
  LOW        maxTurns ×1.0  timeoutMs ×1.0
  MODERATE   maxTurns ×0.8  timeoutMs ×1.2
  HIGH       maxTurns ×0.6  timeoutMs ×1.5
  CRITICAL   maxTurns ×0.4  timeoutMs ×2.0
THRESHOLDS
}

case "$ACTION" in
    recommend) _print_recommend ;;
    summary)   _print_summary ;;
    thresholds) _print_thresholds ;;
esac
